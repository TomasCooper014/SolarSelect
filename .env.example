# Set these in Netlify: Site configuration > Environment variables.
# Anything left blank is skipped, so you can switch features on one at a time.

# Pipedrive (Settings > Personal preferences > API)
PIPEDRIVE_API_TOKEN=
# Lead owner, field keys and option IDs are in config/pipedrive.mjs.
# Set this only to override the default owner (Sarina) for every lead.
PIPEDRIVE_OWNER_ID=

# Your own CRM: receives lead.created and lead.updated as signed JSON
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Confirmation email (resend.com, verify your sending domain first)
RESEND_API_KEY=
EMAIL_FROM=PowerReview <hello@powerreview.com.au>
EMAIL_REPLY_TO=
BRAND_NAME=PowerReview

# Meta Conversions API (Events Manager > your pixel > Settings)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Signs the thank-you page link. Any long random string.
LEAD_TOKEN_SECRET=

# true = renters also go to Pipedrive (default: CRM only)
INCLUDE_RENTERS=false
# true = return integration results to the browser while testing
DEBUG_LEADS=false
